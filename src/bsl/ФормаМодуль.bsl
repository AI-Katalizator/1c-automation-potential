// Внешняя обработка «Потенциал автоматизации учёта поступления услуг» (AI-Katalizator), версия 002.
// Для 1С:Бухгалтерии предприятия 3.0. Только чтение: обработка ничего не записывает в базу,
// не проводит документы, не использует привилегированный режим и не передаёт данные за пределы базы.
//
// Реквизиты, команды и элементы формы создаются программно в ПриСозданииНаСервере,
// поэтому к реквизитам формы обращаемся через ЭтотОбъект["ИмяРеквизита"].
//
// Структура расчёта рассчитана на расширение (сценарии «банковская выписка», «поступление товаров»),
// но в этой версии работает только сценарий «поступление услуг», см. НастройкиСценарияПоступлениеУслуг().

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоздатьРеквизитыФормы();
	СоздатьКомандыФормы();
	СоздатьЭлементыФормы();
	УстановитьЗначенияПоУмолчанию();

	ЭтотОбъект.АвтоЗаголовок = Ложь;
	ЭтотОбъект.Заголовок = "Потенциал автоматизации учёта поступления услуг";

	ЭтотОбъект["ДашбордHTML"] = HTMLПодсказкаДоФормирования();
	ОбновитьДоступностьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)

	Если Не ПараметрыПериодаКорректны() Тогда
		Возврат;
	КонецЕсли;

	СформироватьНаСервере();
	Элементы["Страницы"].ТекущаяСтраница = Элементы["СтраницаДашборд"];

КонецПроцедуры

&НаКлиенте
Процедура ПечатьОтчета(Команда)

	Если Не ЭтотОбъект["Сформировано"] Тогда
		ПоказатьПредупреждение(, "Сначала нажмите «Сформировать».");
		Возврат;
	КонецЕсли;

	Элементы["Страницы"].ТекущаяСтраница = Элементы["СтраницаОтчет"];
	ТабДок = ЭтотОбъект["ТабДок"];
	ТабДок.Напечатать(РежимИспользованияДиалогаПечати.Использовать);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Период или организация изменились: нужен новый запрос к базе.
&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	Если ЭтотОбъект["Сформировано"] Тогда
		СброситьРезультатНаСервере();
	КонецЕсли;

КонецПроцедуры

// Порог, режим, обезличивание, нормы и оклад: пересчёт по уже прочитанным данным, без запроса к базе.
&НаКлиенте
Процедура ПараметрыРасчетаПриИзменении(Элемент)

	Элементы["ПорогМесяцев"].Доступность = ЭтотОбъект["РежимМесяцев"];
	Элементы["ПорогДокументов"].Доступность = Не ЭтотОбъект["РежимМесяцев"];

	Если ЭтотОбъект["Сформировано"] Тогда
		ПересчитатьНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СозданиеФормы

&НаСервере
Процедура СоздатьРеквизитыФормы()

	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ТипЦелое = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный));
	ТипМинуты = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(7, 2, ДопустимыйЗнак.Неотрицательный));
	ТипСумма = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный));
	ТипКоэффициент = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 4, ДопустимыйЗнак.Неотрицательный));
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная));

	Добавляемые = Новый Массив;
	Добавляемые.Добавить(Новый РеквизитФормы("ДатаНачала", ТипДата, , "Период с"));
	Добавляемые.Добавить(Новый РеквизитФормы("ДатаОкончания", ТипДата, , "по"));
	Добавляемые.Добавить(Новый РеквизитФормы("Организация", ТипОрганизации(), , "Организация"));
	Добавляемые.Добавить(Новый РеквизитФормы("ПорогДокументов", ТипЦелое, , "Порог: актов от поставщика за период (N)"));
	Добавляемые.Добавить(Новый РеквизитФормы("РежимМесяцев", ТипБулево, , "Режим «M месяцев из 12»"));
	Добавляемые.Добавить(Новый РеквизитФормы("ПорогМесяцев", ТипЦелое, , "Месяцев с актом (M)"));
	Добавляемые.Добавить(Новый РеквизитФормы("Обезличить", ТипБулево, , "Обезличить поставщиков"));
	Добавляемые.Добавить(Новый РеквизитФормы("Оклад", ТипСумма, , "Оклад бухгалтера, ₽ в месяц"));
	Добавляемые.Добавить(Новый РеквизитФормы("МинВручную", ТипМинуты, , "Вручную, мин на документ"));
	Добавляемые.Добавить(Новый РеквизитФормы("МинСценарий", ТипМинуты, , "Сценарий, мин"));
	Добавляемые.Добавить(Новый РеквизитФормы("МинПроверка", ТипМинуты, , "Проверка бухгалтером, мин"));
	Добавляемые.Добавить(Новый РеквизитФормы("КоэфВзносов", ТипКоэффициент, , "Коэффициент взносов"));
	Добавляемые.Добавить(Новый РеквизитФормы("ЧасовВМесяце", ТипМинуты, , "Норма часов в месяц"));
	Добавляемые.Добавить(Новый РеквизитФормы("ДашбордHTML", ТипСтрока, , "Дашборд"));
	Добавляемые.Добавить(Новый РеквизитФормы("ТабДок", Новый ОписаниеТипов("ТабличныйДокумент"), , "Отчёт"));
	Добавляемые.Добавить(Новый РеквизитФормы("ДанныеРасчета", ТипСтрока, , "Данные расчёта"));
	Добавляемые.Добавить(Новый РеквизитФормы("Сформировано", ТипБулево, , "Сформировано"));

	ИзменитьРеквизиты(Добавляемые);

КонецПроцедуры

&НаСервере
Процедура СоздатьКомандыФормы()

	Команда = Команды.Добавить("Сформировать");
	Команда.Заголовок = "Сформировать";
	Команда.Подсказка = "Прочитать журнал поступлений за период и посчитать показатели";
	Команда.Действие = "Сформировать";

	Команда = Команды.Добавить("ПечатьОтчета");
	Команда.Заголовок = "Печать";
	Команда.Подсказка = "Напечатать отчёт с теми же цифрами";
	Команда.Действие = "ПечатьОтчета";

КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыФормы()

	// Строка 1: период, организация, порог, режим, обезличивание и кнопки.
	ГруппаОтбор = ДобавитьГруппу("ГруппаОтбор", "", ЭтотОбъект, Истина);
	ДобавитьПолеВвода("ДатаНачала", ГруппаОтбор, "ПериодПриИзменении", 10);
	ДобавитьПолеВвода("ДатаОкончания", ГруппаОтбор, "ПериодПриИзменении", 10);
	ПолеОрганизация = ДобавитьПолеВвода("Организация", ГруппаОтбор, "ПериодПриИзменении", 25);
	ПолеОрганизация.Подсказка = "Пусто — все организации базы";
	ПолеОрганизация.Видимость = ЕстьСправочникОрганизаций();
	ДобавитьПолеВвода("ПорогДокументов", ГруппаОтбор, "ПараметрыРасчетаПриИзменении", 4);
	ДобавитьФлажок("РежимМесяцев", ГруппаОтбор);
	ДобавитьПолеВвода("ПорогМесяцев", ГруппаОтбор, "ПараметрыРасчетаПриИзменении", 4);
	ДобавитьФлажок("Обезличить", ГруппаОтбор);

	ГруппаКнопки = ДобавитьГруппу("ГруппаКнопки", "", ЭтотОбъект, Истина);
	Кнопка = Элементы.Добавить("КнопкаСформировать", Тип("КнопкаФормы"), ГруппаКнопки);
	Кнопка.ИмяКоманды = "Сформировать";
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.КнопкаПоУмолчанию = Истина;
	Кнопка = Элементы.Добавить("КнопкаПечать", Тип("КнопкаФормы"), ГруппаКнопки);
	Кнопка.ИмяКоманды = "ПечатьОтчета";
	Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;

	// Строка 2: нормы времени и оклад (пересчёт без запроса к базе).
	ГруппаНормы = ДобавитьГруппу("ГруппаНормы", "Нормы и оклад (пересчёт сразу, без нового запроса к базе)", ЭтотОбъект, Истина);
	ДобавитьПолеВвода("Оклад", ГруппаНормы, "ПараметрыРасчетаПриИзменении", 10);
	ДобавитьПолеВвода("МинВручную", ГруппаНормы, "ПараметрыРасчетаПриИзменении", 5);
	ДобавитьПолеВвода("МинСценарий", ГруппаНормы, "ПараметрыРасчетаПриИзменении", 5);
	ДобавитьПолеВвода("МинПроверка", ГруппаНормы, "ПараметрыРасчетаПриИзменении", 5);
	ДобавитьПолеВвода("КоэфВзносов", ГруппаНормы, "ПараметрыРасчетаПриИзменении", 6);
	ДобавитьПолеВвода("ЧасовВМесяце", ГруппаНормы, "ПараметрыРасчетаПриИзменении", 6);

	// Страницы: дашборд (HTML) и отчёт для печати (табличный документ).
	Страницы = Элементы.Добавить("Страницы", Тип("ГруппаФормы"), ЭтотОбъект);
	Страницы.Вид = ВидГруппыФормы.Страницы;

	СтраницаДашборд = Элементы.Добавить("СтраницаДашборд", Тип("ГруппаФормы"), Страницы);
	СтраницаДашборд.Вид = ВидГруппыФормы.Страница;
	СтраницаДашборд.Заголовок = "Дашборд";

	ПолеHTML = Элементы.Добавить("ДашбордHTML", Тип("ПолеФормы"), СтраницаДашборд);
	ПолеHTML.Вид = ВидПоляФормы.ПолеHTMLДокумента;
	ПолеHTML.ПутьКДанным = "ДашбордHTML";
	ПолеHTML.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеHTML.РастягиватьПоГоризонтали = Истина;
	ПолеHTML.РастягиватьПоВертикали = Истина;
	ПолеHTML.Высота = 30;

	СтраницаОтчет = Элементы.Добавить("СтраницаОтчет", Тип("ГруппаФормы"), Страницы);
	СтраницаОтчет.Вид = ВидГруппыФормы.Страница;
	СтраницаОтчет.Заголовок = "Отчёт для печати";

	ПолеТабДок = Элементы.Добавить("ТабДок", Тип("ПолеФормы"), СтраницаОтчет);
	ПолеТабДок.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
	ПолеТабДок.ПутьКДанным = "ТабДок";
	ПолеТабДок.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеТабДок.РастягиватьПоГоризонтали = Истина;
	ПолеТабДок.РастягиватьПоВертикали = Истина;

КонецПроцедуры

&НаСервере
Функция ДобавитьГруппу(Имя, Заголовок, Родитель, Горизонтальная)

	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = Заголовок;
	Группа.ОтображатьЗаголовок = Не ПустаяСтрока(Заголовок);
	Если Горизонтальная Тогда
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Иначе
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	Возврат Группа;

КонецФункции

&НаСервере
Функция ДобавитьПолеВвода(Имя, Родитель, ОбработчикИзменения, Ширина)

	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = Имя;
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	Поле.Ширина = Ширина;
	Поле.РастягиватьПоГоризонтали = Ложь;
	Поле.УстановитьДействие("ПриИзменении", ОбработчикИзменения);
	Возврат Поле;

КонецФункции

&НаСервере
Функция ДобавитьФлажок(Имя, Родитель)

	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеФлажка;
	Поле.ПутьКДанным = Имя;
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	Поле.УстановитьДействие("ПриИзменении", "ПараметрыРасчетаПриИзменении");
	Возврат Поле;

КонецФункции

// Тип реквизита «Организация». Если в конфигурации нет справочника «Организации», поле скрывается,
// а расчёт идёт по всем документам, как без отбора.
&НаСервереБезКонтекста
Функция ЕстьСправочникОрганизаций()

	Возврат Метаданные.Справочники.Найти("Организации") <> Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция ТипОрганизации()

	Если ЕстьСправочникОрганизаций() Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.Организации");
	КонецЕсли;
	Возврат Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная));

КонецФункции

// Отбор по организации нужен, только если она выбрана. Пусто — все организации.
&НаСервереБезКонтекста
Функция ОтбиратьПоОрганизации(Организация)

	Возврат ЕстьСправочникОрганизаций() И ЗначениеЗаполнено(Организация);

КонецФункции

&НаСервере
Процедура УстановитьЗначенияПоУмолчанию()

	// По умолчанию — прошлый календарный год относительно даты запуска.
	ПрошлыйГод = Год(ТекущаяДатаСеанса()) - 1;
	ЭтотОбъект["ДатаНачала"] = Дата(ПрошлыйГод, 1, 1);
	ЭтотОбъект["ДатаОкончания"] = Дата(ПрошлыйГод, 12, 31);
	ЭтотОбъект["ПорогДокументов"] = 3;
	ЭтотОбъект["РежимМесяцев"] = Ложь;
	ЭтотОбъект["ПорогМесяцев"] = 9;
	ЭтотОбъект["Обезличить"] = Ложь;
	ЭтотОбъект["Оклад"] = 100000;
	ЭтотОбъект["МинВручную"] = 5;
	ЭтотОбъект["МинСценарий"] = 0.5;
	ЭтотОбъект["МинПроверка"] = 0.5;
	ЭтотОбъект["КоэфВзносов"] = 1.302;
	ЭтотОбъект["ЧасовВМесяце"] = 164.3;
	ЭтотОбъект["Сформировано"] = Ложь;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьНаСервере()

	Элементы["ПорогМесяцев"].Доступность = ЭтотОбъект["РежимМесяцев"];
	Элементы["ПорогДокументов"].Доступность = Не ЭтотОбъект["РежимМесяцев"];

КонецПроцедуры

#КонецОбласти

#Область СценарииРасчета

// Описание сценария «поступление услуг». Точка расширения: по такому же описанию в следующих версиях
// добавляются сценарии «банковская выписка» и «поступление товаров» (в этой версии их нет).
//
// Имена значений перечисления ВидыОперацийПоступлениеТоваровУслуг (типовая БП 3.0):
//   «Услуги»          — вид операции «Услуги (акт, УПД)», единственный включаемый в расчёт;
//   «ПокупкаКомиссия» — смешанный вид «Товары, услуги, комиссия», в расчёт не входит (считается только для подсказки).
// Значения ищутся по метаданным во время работы; если в релизе имя другое, обработка сообщит об этом и ничего не посчитает.
&НаСервереБезКонтекста
Функция НастройкиСценарияПоступлениеУслуг()

	Настройки = Новый Структура;
	Настройки.Вставить("Ключ", "ПоступлениеУслуг");
	Настройки.Вставить("Документ", "ПоступлениеТоваровУслуг");
	Настройки.Вставить("Перечисление", "ВидыОперацийПоступлениеТоваровУслуг");
	Настройки.Вставить("ВидОперации", "Услуги");
	Настройки.Вставить("ВидОперацииСмешанный", "ПокупкаКомиссия");
	Настройки.Вставить("ДокументСчетФактура", "СчетФактураПолученный");
	Возврат Настройки;

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеПеречисления(ИмяПеречисления, ИмяЗначения)

	МетаПеречисление = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если МетаПеречисление = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если МетаПеречисление.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];

КонецФункции

// Один пакетный проход по журналу: документы сценария, сгруппированные по поставщику и месяцу.
&НаСервереБезКонтекста
Функция ПрочитатьДанныеИзБазы(ДатаНачала, ДатаОкончания, Организация)

	Сценарий = НастройкиСценарияПоступлениеУслуг();

	Если Метаданные.Документы.Найти(Сценарий.Документ) = Неопределено Тогда
		СообщитьПользователю("В базе нет документа «Поступление (акт, накладная, УПД)». Обработка рассчитана на 1С:Бухгалтерию предприятия 3.0.");
		Возврат Неопределено;
	КонецЕсли;

	ВидОперации = ЗначениеПеречисления(Сценарий.Перечисление, Сценарий.ВидОперации);
	Если ВидОперации = Неопределено Тогда
		СообщитьПользователю("В базе не найден вид операции «Услуги» у документа «Поступление (акт, накладная, УПД)». Расчёт не выполнен.");
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Контрагент КАК Контрагент,
	|	Док.Контрагент.Наименование КАК Наименование,
	|	НАЧАЛОПЕРИОДА(Док.Дата, МЕСЯЦ) КАК Месяц,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Док.Ссылка) КАК Документов
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг КАК Док
	|ГДЕ
	|	Док.Проведен
	|	И НЕ Док.ПометкаУдаления
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Док.ВидОперации = &ВидОперации
	|	#ОтборОрганизации#
	|
	|СГРУППИРОВАТЬ ПО
	|	Док.Контрагент,
	|	Док.Контрагент.Наименование,
	|	НАЧАЛОПЕРИОДА(Док.Дата, МЕСЯЦ)";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	ОтборОрганизации = ОтбиратьПоОрганизации(Организация);
	Если ОтборОрганизации Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ОтборОрганизации#", "И Док.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ОтборОрганизации#", "");
	КонецЕсли;

	Попытка
		Выборка = Запрос.Выполнить().Выгрузить();
	Исключение
		СообщитьПользователю("Не удалось прочитать журнал поступлений. Возможно, не хватает прав на чтение документов. Подробности: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Поставщики = Новый ТаблицаЗначений;
	Поставщики.Колонки.Добавить("Контрагент");
	Поставщики.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	Поставщики.Колонки.Добавить("Документов", Новый ОписаниеТипов("Число"));
	Поставщики.Колонки.Добавить("Месяцев", Новый ОписаниеТипов("Число"));

	Для Каждого СтрокаВыборки Из Выборка Цикл
		НоваяСтрока = Поставщики.Добавить();
		НоваяСтрока.Контрагент = СтрокаВыборки.Контрагент;
		Если ЗначениеЗаполнено(СтрокаВыборки.Наименование) Тогда
			НоваяСтрока.Наименование = СтрокаВыборки.Наименование;
		Иначе
			НоваяСтрока.Наименование = "<поставщик не указан>";
		КонецЕсли;
		НоваяСтрока.Документов = СтрокаВыборки.Документов;
		НоваяСтрока.Месяцев = 1; // одна строка выборки = один месяц с документами
	КонецЦикла;

	Поставщики.Свернуть("Контрагент, Наименование", "Документов, Месяцев");
	// Стабильный порядок для обезличивания «Поставщик 1…N»: по убыванию числа актов, затем по наименованию.
	Поставщики.Сортировать("Документов Убыв, Наименование Возр");
	Поставщики.Колонки.Удалить("Контрагент");

	Данные = Новый Структура;
	Данные.Вставить("Сценарий", Сценарий.Ключ);
	Данные.Вставить("ДатаНачала", НачалоДня(ДатаНачала));
	Данные.Вставить("ДатаОкончания", НачалоДня(ДатаОкончания));
	// Для вывода хранится только представление организации; пустая строка — все организации.
	Данные.Вставить("Организация", ?(ОтборОрганизации, Строка(Организация), ""));
	Данные.Вставить("Поставщики", Поставщики);
	Данные.Вставить("Смешанных", КоличествоДокументов(Сценарий.Документ, ДатаНачала, ДатаОкончания,
		ЗначениеПеречисления(Сценарий.Перечисление, Сценарий.ВидОперацииСмешанный), Истина, Организация));
	Данные.Вставить("СчетовФактур", КоличествоДокументов(Сценарий.ДокументСчетФактура, ДатаНачала, ДатаОкончания,
		Неопределено, Ложь, Организация));
	Данные.Вставить("ДатаФормирования", ТекущаяДатаСеанса());
	Возврат Данные;

КонецФункции

// Вспомогательный подсчёт для подсказки «что не включено». При любой ошибке возвращает Неопределено.
&НаСервереБезКонтекста
Функция КоличествоДокументов(ИмяДокумента, ДатаНачала, ДатаОкончания, ВидОперации, ОтборПоВидуОперации, Организация)

	Если Метаданные.Документы.Найти(ИмяДокумента) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ОтборПоВидуОперации И ВидОперации = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Док.Ссылка) КАК Количество
	|ИЗ
	|	Документ.#ИмяДокумента# КАК Док
	|ГДЕ
	|	Док.Проведен
	|	И НЕ Док.ПометкаУдаления
	|	И Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	Если ОтборПоВидуОперации Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И Док.ВидОперации = &ВидОперации";
		Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	КонецЕсли;
	Если ОтбиратьПоОрганизации(Организация) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И Док.Организация = &Организация";
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "#ИмяДокумента#", ИмяДокумента);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Количество;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат 0;

КонецФункции

#КонецОбласти

#Область Расчет

&НаСервере
Процедура СформироватьНаСервере()

	Данные = ПрочитатьДанныеИзБазы(ЭтотОбъект["ДатаНачала"], ЭтотОбъект["ДатаОкончания"], ЭтотОбъект["Организация"]);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭтотОбъект["ДанныеРасчета"] = ЗначениеВСтрокуВнутр(Данные);
	ЭтотОбъект["Сформировано"] = Истина;
	ВывестиРезультаты(Данные);

КонецПроцедуры

&НаСервере
Процедура ПересчитатьНаСервере()

	ОбновитьДоступностьНаСервере();
	Если ПустаяСтрока(ЭтотОбъект["ДанныеРасчета"]) Тогда
		Возврат;
	КонецЕсли;
	ВывестиРезультаты(ЗначениеИзСтрокиВнутр(ЭтотОбъект["ДанныеРасчета"]));

КонецПроцедуры

&НаСервере
Процедура СброситьРезультатНаСервере()

	ЭтотОбъект["Сформировано"] = Ложь;
	ЭтотОбъект["ДанныеРасчета"] = "";
	ЭтотОбъект["ДашбордHTML"] = HTMLПодсказкаДоФормирования();
	ТабДок = ЭтотОбъект["ТабДок"];
	ТабДок.Очистить();

КонецПроцедуры

&НаСервере
Процедура ВывестиРезультаты(Данные)

	НастройкиРасчета = ПараметрыРасчета();
	Показатели = РассчитатьПоказатели(Данные, НастройкиРасчета);
	Значения = ЗначенияДляДашборда(Показатели, Данные, НастройкиРасчета);
	ЭтотОбъект["ДашбордHTML"] = ЗаполнитьШаблон(ШаблонДашборда(), Значения);
	ЗаполнитьТабличныйДокумент(Показатели, Данные, НастройкиРасчета, Значения);

КонецПроцедуры

&НаСервере
Функция ПараметрыРасчета()

	П = Новый Структура;
	П.Вставить("ПорогДокументов", ЭтотОбъект["ПорогДокументов"]);
	П.Вставить("РежимМесяцев", ЭтотОбъект["РежимМесяцев"]);
	П.Вставить("ПорогМесяцев", ЭтотОбъект["ПорогМесяцев"]);
	П.Вставить("Обезличить", ЭтотОбъект["Обезличить"]);
	П.Вставить("Оклад", ЭтотОбъект["Оклад"]);
	П.Вставить("МинВручную", ЭтотОбъект["МинВручную"]);
	П.Вставить("МинСценарий", ЭтотОбъект["МинСценарий"]);
	П.Вставить("МинПроверка", ЭтотОбъект["МинПроверка"]);
	П.Вставить("КоэфВзносов", ЭтотОбъект["КоэфВзносов"]);
	П.Вставить("ЧасовВМесяце", ЭтотОбъект["ЧасовВМесяце"]);
	Возврат П;

КонецФункции

// Формулы расчёта экономии. Округление только при выводе; рубли считаются от точных часов.
// Зеркало на Python: tests/mirror.py, функция calculate().
&НаСервереБезКонтекста
Функция РассчитатьПоказатели(Данные, П)

	МесяцевПериода = КоличествоМесяцев(Данные.ДатаНачала, Данные.ДатаОкончания);
	ПолныхМесяцев = КоличествоПолныхМесяцев(Данные.ДатаНачала, Данные.ДатаОкончания);
	Если ПолныхМесяцев > 0 Тогда
		ПорогМесяцевФакт = Мин(П.ПорогМесяцев, ПолныхМесяцев);
	Иначе
		ПорогМесяцевФакт = П.ПорогМесяцев;
	КонецЕсли;

	Всего = 0;
	Кандидатов = 0;
	ПоставщиковКандидатов = 0;
	Для Каждого СтрокаПоставщика Из Данные.Поставщики Цикл
		Всего = Всего + СтрокаПоставщика.Документов;
		Если ЭтоКандидат(СтрокаПоставщика, П, ПорогМесяцевФакт) Тогда
			Кандидатов = Кандидатов + СтрокаПоставщика.Документов;
			ПоставщиковКандидатов = ПоставщиковКандидатов + 1;
		КонецЕсли;
	КонецЦикла;
	Поставщиков = Данные.Поставщики.Количество();

	Р = Новый Структура;
	Р.Вставить("Всего", Всего);
	Р.Вставить("Поставщиков", Поставщиков);
	Р.Вставить("Кандидатов", Кандидатов);
	Р.Вставить("ПоставщиковКандидатов", ПоставщиковКандидатов);
	Р.Вставить("Остальных", Всего - Кандидатов);
	Р.Вставить("ПоставщиковОстальных", Поставщиков - ПоставщиковКандидатов);
	Р.Вставить("Доля", ?(Всего > 0, Окр(Кандидатов / Всего * 100, 0), 0));
	Р.Вставить("МинутВручную", Всего * П.МинВручную);
	Р.Вставить("МинутСАвтоматизацией", Кандидатов * (П.МинСценарий + П.МинПроверка) + (Всего - Кандидатов) * П.МинВручную);
	Р.Вставить("МинутЭкономии", Р.МинутВручную - Р.МинутСАвтоматизацией);
	Р.Вставить("ЧасовЭкономии", Р.МинутЭкономии / 60);
	Р.Вставить("Ставка", ?(П.ЧасовВМесяце > 0, П.Оклад * П.КоэфВзносов / П.ЧасовВМесяце, 0));
	Р.Вставить("Рублей", Р.ЧасовЭкономии * Р.Ставка);
	Р.Вставить("МесяцевПериода", МесяцевПериода);
	Р.Вставить("ПолныхМесяцев", ПолныхМесяцев);
	Р.Вставить("ПорогМесяцевФакт", ПорогМесяцевФакт);
	Р.Вставить("РублейВМесяц", Р.Рублей / МесяцевПериода);
	Р.Вставить("ЧасовВМесяц", Р.ЧасовЭкономии / МесяцевПериода);
	Р.Вставить("ПроцентВремени", ?(Р.МинутВручную > 0, Окр(Р.МинутЭкономии / Р.МинутВручную * 100, 0), 0));
	Возврат Р;

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоКандидат(СтрокаПоставщика, П, ПорогМесяцевФакт)

	Если П.РежимМесяцев Тогда
		Возврат СтрокаПоставщика.Месяцев >= ПорогМесяцевФакт;
	КонецЕсли;
	Возврат СтрокаПоставщика.Документов >= П.ПорогДокументов;

КонецФункции

// Число календарных месяцев, которых касается период (для года — 12). Делитель «в месяц».
&НаСервереБезКонтекста
Функция КоличествоМесяцев(ДатаНачала, ДатаОкончания)

	Возврат Макс(1, (Год(ДатаОкончания) - Год(ДатаНачала)) * 12 + Месяц(ДатаОкончания) - Месяц(ДатаНачала) + 1);

КонецФункции

// Число полных календарных месяцев внутри периода (для режима «M месяцев из 12»).
&НаСервереБезКонтекста
Функция КоличествоПолныхМесяцев(ДатаНачала, ДатаОкончания)

	Количество = 0;
	НачалоТекущегоМесяца = НачалоМесяца(ДатаНачала);
	Пока НачалоТекущегоМесяца <= ДатаОкончания Цикл
		Если НачалоДня(ДатаНачала) <= НачалоТекущегоМесяца
			И КонецДня(ДатаОкончания) >= КонецМесяца(НачалоТекущегоМесяца) Тогда
			Количество = Количество + 1;
		КонецЕсли;
		НачалоТекущегоМесяца = ДобавитьМесяц(НачалоТекущегоМесяца, 1);
	КонецЦикла;
	Возврат Количество;

КонецФункции

&НаКлиенте
Функция ПараметрыПериодаКорректны()

	Если Не ЗначениеЗаполнено(ЭтотОбъект["ДатаНачала"]) Или Не ЗначениеЗаполнено(ЭтотОбъект["ДатаОкончания"]) Тогда
		ПоказатьПредупреждение(, "Укажите начало и конец периода.");
		Возврат Ложь;
	КонецЕсли;
	Если ЭтотОбъект["ДатаНачала"] > ЭтотОбъект["ДатаОкончания"] Тогда
		ПоказатьПредупреждение(, "Начало периода позже его конца.");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Дашборд

// Значения для подстановки в шаблон дашборда v10. Тексты макета не меняются, подставляются только числа
// (и слова, которые зависят от числа или режима). Зеркало: tests/mirror.py, dashboard_values().
&НаСервереБезКонтекста
Функция ЗначенияДляДашборда(Р, Данные, П)

	ДатаНачала = Данные.ДатаНачала;
	ДатаОкончания = Данные.ДатаОкончания;
	ПолныйГод = (ДатаНачала = НачалоГода(ДатаНачала) И ДатаОкончания = НачалоДня(КонецГода(ДатаНачала)));
	Если ПолныйГод Тогда
		ЗаголовокПериода = "за " + Формат(Год(ДатаНачала), "ЧГ=0") + " год";
	Иначе
		ЗаголовокПериода = "за " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " – " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Если Год(ДатаНачала) = Год(ДатаОкончания) Тогда
		ПериодКоротко = Формат(ДатаНачала, "ДФ=dd.MM") + " – " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	Иначе
		ПериодКоротко = Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " – " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	ЕдиницаПериода = ?(Р.МесяцевПериода = 12, "в год", "за период");

	// Организация в шапке: при обезличивании название не выводится.
	Организация = "";
	Если Данные.Свойство("Организация") Тогда
		Организация = Данные.Организация;
	КонецЕсли;
	Если ПустаяСтрока(Организация) Тогда
		ТекстОрганизации = "Все организации";
	ИначеЕсли П.Обезличить Тогда
		ТекстОрганизации = "Организация скрыта";
	Иначе
		ТекстОрганизации = "Организация: " + Организация;
	КонецЕсли;

	Если Данные.Смешанных = Неопределено Или Данные.СчетовФактур = Неопределено Тогда
		ТекстИсключено = "Не включены: смешанные поступления «товары, услуги, комиссия» и полученные счета-фактуры.";
	Иначе
		ТекстИсключено = "Не включены: " + ФЦел(Данные.Смешанных) + " "
			+ ФормаСлова(Данные.Смешанных, "смешанное поступление", "смешанных поступления", "смешанных поступлений")
			+ " «товары, услуги, комиссия» и " + ФЦел(Данные.СчетовФактур) + " "
			+ ФормаСлова(Данные.СчетовФактур, "полученный счёт-фактура", "полученных счёта-фактуры", "полученных счетов-фактур") + ".";
	КонецЕсли;

	Если П.РежимМесяцев Тогда
		КритерийПодсказка = "у каждого акты были не меньше чем в " + ФЦел(Р.ПорогМесяцевФакт) + " месяцах из " + ФЦел(Р.ПолныхМесяцев);
		Критерий = "у поставщика акты или УПД были не меньше чем в " + ФЦел(Р.ПорогМесяцевФакт) + " месяцах из "
			+ ФЦел(Р.ПолныхМесяцев) + " полных месяцев периода.";
		ХвостОстальных = "с более редкими актами";
	Иначе
		Порог = П.ПорогДокументов;
		КритерийПодсказка = "от каждого пришло " + ФЦел(Порог) + " и более " + АктаИлиАктов(Порог) + " за период";
		Критерий = "от поставщика пришло " + ФЦел(Порог) + " и более " + АктаИлиАктов(Порог) + " или УПД за период.";
		Если Порог - 1 >= 2 Тогда
			ХвостОстальных = "с 1–" + ФЦел(Порог - 1) + " актами";
		Иначе
			ХвостОстальных = "с 1 актом";
		КонецЕсли;
	КонецЕсли;

	Если Р.Остальных > 0 Тогда
		ТекстОстальных = " Остальные " + ФЦел(Р.Остальных) + " " + ФормаСлова(Р.Остальных, "акт", "акта", "актов")
			+ " — от " + ФЦел(Р.ПоставщиковОстальных) + " " + ПоставщикаИлиПоставщиков(Р.ПоставщиковОстальных)
			+ " " + ХвостОстальных + ", они остаются за бухгалтером.";
	Иначе
		ТекстОстальных = " Остальных документов нет.";
	КонецЕсли;

	ДлинаОкружности = 2 * 3.14159265358979 * 24;
	ДлинаДуги = ?(Р.Всего > 0, Р.Кандидатов / Р.Всего * ДлинаОкружности, 0);
	МинутАвтоНаДокумент = П.МинСценарий + П.МинПроверка;
	Масштаб = 100 / Макс(П.МинВручную, МинутАвтоНаДокумент, 0.0001);
	ДоляСценария = ?(МинутАвтоНаДокумент > 0, П.МинСценарий / МинутАвтоНаДокумент * 100, 50);

	З = Новый Соответствие;
	З.Вставить("ЗАГОЛОВОК_ПЕРИОДА", ЗаголовокПериода);
	З.Вставить("ОРГАНИЗАЦИЯ_ТЕКСТ", ТекстОрганизации);
	З.Вставить("ПОДСКАЗКА_ВСЕГО", "Документы «Поступление (акт, накладная, УПД)» с видом операции «Услуги» за период. " + ТекстИсключено);
	З.Вставить("ВСЕГО", ФЦел(Р.Всего));
	З.Вставить("ПОСТАВЩИКОВ_ТЕКСТ", ФЦел(Р.Поставщиков) + " " + ПоставщикаИлиПоставщиков(Р.Поставщиков));
	З.Вставить("ПОДСКАЗКА_КАНДИДАТЫ", "Повторяющиеся операции: акты от " + ФЦел(Р.ПоставщиковКандидатов) + " "
		+ ПоставщикаИлиПоставщиков(Р.ПоставщиковКандидатов) + ", " + КритерийПодсказка + "." + ТекстОстальных);
	З.Вставить("КАНДИДАТЫ", ФЦел(Р.Кандидатов));
	З.Вставить("ПОСТАВЩИКОВ_КАНДИДАТОВ_ТЕКСТ", ФЦел(Р.ПоставщиковКандидатов) + " " + ПоставщикаИлиПоставщиков(Р.ПоставщиковКандидатов));
	З.Вставить("КОЛЬЦО_ДЛИНА", ЧислоДляСтиля(ДлинаДуги));
	З.Вставить("КОЛЬЦО_ОСТАТОК", ЧислоДляСтиля(ДлинаОкружности - ДлинаДуги));
	З.Вставить("ДОЛЯ", ФЦел(Р.Доля));
	З.Вставить("ПОДСКАЗКА_ДОЛЯ", ФЦел(Р.Кандидатов) + " повторяющихся из " + ФЦел(Р.Всего) + " документов поступления услуг.");
	З.Вставить("ПОДСКАЗКА_ПЕРИОД", "Журнал операций базы " + ЗаголовокПериода + ?(П.Обезличить, "; база обезличена.", "."));
	З.Вставить("ПЕРИОД_КОРОТКО", ПериодКоротко);
	З.Вставить("МЕСЯЦЕВ_ТЕКСТ", ФЦел(Р.МесяцевПериода) + " " + ФормаСлова(Р.МесяцевПериода, "месяц", "месяца", "месяцев"));
	З.Вставить("ЕД_ПЕРИОДА", ЕдиницаПериода);
	З.Вставить("ЧАСОВ", ФОдин(Р.ЧасовЭкономии));
	З.Вставить("ЧАСОВ_В_МЕСЯЦ", ФОдин(Р.ЧасовВМесяц));
	З.Вставить("ПРОЦЕНТ_ВРЕМЕНИ", ФЦел(Р.ПроцентВремени));
	З.Вставить("РУБЛЕЙ", ФЦел(Р.Рублей));
	З.Вставить("РУБЛЕЙ_В_МЕСЯЦ", ФЦел(Р.РублейВМесяц));
	З.Вставить("ОКЛАД_ВВОД", Формат(П.Оклад, "ЧГ=0; ЧН=0"));
	З.Вставить("МВР", ФМин(П.МинВручную));
	З.Вставить("МСЦ", ФМин(П.МинСценарий));
	З.Вставить("МПР", ФМин(П.МинПроверка));
	З.Вставить("МИН_ВРУЧНУЮ", ФЦел(Р.МинутВручную));
	З.Вставить("ОСТАЛЬНЫЕ", ФЦел(Р.Остальных));
	З.Вставить("МИН_С_АВТО", ФМин(Р.МинутСАвтоматизацией));
	З.Вставить("МИН_ЭКОНОМИЯ", ФМин(Р.МинутЭкономии));
	З.Вставить("ОКЛАД", ФЦел(П.Оклад));
	З.Вставить("КОЭФ_ВЗНОСОВ", ФМин(П.КоэфВзносов));
	З.Вставить("ЧАСОВ_В_МЕСЯЦЕ_НОРМА", ФМин(П.ЧасовВМесяце));
	З.Вставить("СТАВКА", ФЦел(Р.Ставка));
	З.Вставить("ЧАСОВ_2", ФДва(Р.ЧасовЭкономии));
	З.Вставить("СТАВКА_2", ФДва(Р.Ставка));
	З.Вставить("КРИТЕРИЙ", Критерий);
	З.Вставить("ШИРИНА_АВТО", ЧислоДляСтиля(МинутАвтоНаДокумент * Масштаб * 0.82));
	З.Вставить("ШИРИНА_ВРУЧНУЮ", ЧислоДляСтиля(П.МинВручную * Масштаб * 0.82));
	З.Вставить("ДОЛЯ_СЦЕНАРИЙ", ЧислоДляСтиля(ДоляСценария));
	З.Вставить("ДОЛЯ_ПРОВЕРКА", ЧислоДляСтиля(100 - ДоляСценария));
	З.Вставить("МИН_АВТО_НА_ДОК", ФМин(МинутАвтоНаДокумент));
	Возврат З;

КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьШаблон(Шаблон, Значения)

	Результат = Шаблон;
	Для Каждого КлючИЗначение Из Значения Цикл
		Результат = СтрЗаменить(Результат, "{{" + КлючИЗначение.Ключ + "}}", ЭкранироватьHTML(КлючИЗначение.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЭкранироватьHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция HTMLПодсказкаДоФормирования()

	Возврат "<!DOCTYPE html><html><head><meta charset=""utf-8""><meta http-equiv=""X-UA-Compatible"" content=""IE=edge""></head>"
		+ "<body style=""margin:0;font-family:Inter,'Helvetica Neue',Arial,sans-serif;color:#4b5160;font-size:14px"">"
		+ "<div style=""margin:20px 24px;padding:18px;background:#f3f5f8;border-radius:16px"">"
		+ "<div style=""font-size:20px;font-weight:600;color:#16181d;margin-bottom:8px"">Потенциал автоматизации учёта поступления услуг</div>"
		+ "Выберите период и нажмите «Сформировать». Обработка только читает журнал поступлений и ничего не меняет в базе."
		+ "</div></body></html>";

КонецФункции

// Шаблон дашборда v10 (src/html/dashboard_v10.html). Тело функции генерирует build.sh — не править вручную.
// @@ШАБЛОН_ДАШБОРДА@@

#КонецОбласти

#Область ПечатнаяФорма

// Отчёт для печати и сохранения в PDF/Excel: те же цифры, что на дашборде. Без макета, строится кодом.
&НаСервере
Процедура ЗаполнитьТабличныйДокумент(Р, Данные, П, З)

	ТД = ЭтотОбъект["ТабДок"];
	ТД.Очистить();
	ТД.ОтображатьСетку = Ложь;
	ТД.ОтображатьЗаголовки = Ложь;
	ТД.ТолькоПросмотр = Истина;
	ТД.АвтоМасштаб = Истина;
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;

	УстановитьШиринуКолонки(ТД, 1, 5);
	УстановитьШиринуКолонки(ТД, 2, 44);
	УстановитьШиринуКолонки(ТД, 3, 16);
	УстановитьШиринуКолонки(ТД, 4, 16);
	УстановитьШиринуКолонки(ТД, 5, 30);

	ЦветАкцент = Новый Цвет(11, 107, 82);
	ЦветСерый = Новый Цвет(128, 134, 154);

	НомерСтроки = 1;
	ВывестиТекстНаВсюШирину(ТД, НомерСтроки, "Потенциал автоматизации учёта поступления услуг", 14, Истина, Неопределено);
	НомерСтроки = НомерСтроки + 1;
	ВывестиТекстНаВсюШирину(ТД, НомерСтроки, "Акты и УПД на услуги от поставщиков · журнал операций " + З.Получить("ЗАГОЛОВОК_ПЕРИОДА")
		+ " · " + З.Получить("ОРГАНИЗАЦИЯ_ТЕКСТ") + " · Дашборд для руководителя · AI-Katalizator", 9, Ложь, ЦветСерый);
	НомерСтроки = НомерСтроки + 1;
	ВывестиТекстНаВсюШирину(ТД, НомерСтроки, "Сформировано " + Формат(Данные.ДатаФормирования, "ДЛФ=DT")
		+ ". Обработка только читает данные базы.", 8, Ложь, ЦветСерый);
	НомерСтроки = НомерСтроки + 2;

	ВывестиЗаголовокРаздела(ТД, НомерСтроки, "Показатели");
	ВывестиСтрокуПоказателя(ТД, НомерСтроки, "Всего документов поступления услуг", З.Получить("ВСЕГО"), "от " + З.Получить("ПОСТАВЩИКОВ_ТЕКСТ"));
	ВывестиСтрокуПоказателя(ТД, НомерСтроки, "Кандидаты на автоматизацию", З.Получить("КАНДИДАТЫ"), "от " + З.Получить("ПОСТАВЩИКОВ_КАНДИДАТОВ_ТЕКСТ"));
	ВывестиСтрокуПоказателя(ТД, НомерСтроки, "Доля к автоматизации", З.Получить("ДОЛЯ") + "%", З.Получить("КАНДИДАТЫ") + " из " + З.Получить("ВСЕГО"));
	ВывестиСтрокуПоказателя(ТД, НомерСтроки, "Период анализа", З.Получить("ПЕРИОД_КОРОТКО"), З.Получить("МЕСЯЦЕВ_ТЕКСТ"));
	ВывестиТекстНаВсюШирину(ТД, НомерСтроки, "Критерий: " + З.Получить("КРИТЕРИЙ") + " " + З.Получить("ПОДСКАЗКА_ВСЕГО"), 8, Ложь, ЦветСерый);
	НомерСтроки = НомерСтроки + 2;

	ВывестиЗаголовокРаздела(ТД, НомерСтроки, "Экономия");
	ВывестиСтрокуПоказателя(ТД, НомерСтроки, "Часов " + З.Получить("ЕД_ПЕРИОДА"), З.Получить("ЧАСОВ") + " ч",
		"≈ " + З.Получить("ЧАСОВ_В_МЕСЯЦ") + " ч в месяц · −" + З.Получить("ПРОЦЕНТ_ВРЕМЕНИ") + "% времени на эти документы");
	ВывестиСтрокуПоказателя(ТД, НомерСтроки, "Рублей " + З.Получить("ЕД_ПЕРИОДА"), З.Получить("РУБЛЕЙ") + " ₽",
		"≈ " + З.Получить("РУБЛЕЙ_В_МЕСЯЦ") + " ₽ в месяц", ЦветАкцент);
	НомерСтроки = НомерСтроки + 1;

	ВывестиЗаголовокРаздела(ТД, НомерСтроки, "Как посчитана экономия");
	ВывестиСтрокуФормулы(ТД, НомерСтроки, "Без автоматизации",
		З.Получить("ВСЕГО") + " × " + З.Получить("МВР") + " = " + З.Получить("МИН_ВРУЧНУЮ") + " мин");
	ВывестиСтрокуФормулы(ТД, НомерСтроки, "С автоматизацией",
		З.Получить("КАНДИДАТЫ") + " × (" + З.Получить("МСЦ") + " + " + З.Получить("МПР") + ") + " + З.Получить("ОСТАЛЬНЫЕ")
		+ " × " + З.Получить("МВР") + " = " + З.Получить("МИН_С_АВТО") + " мин");
	ВывестиСтрокуФормулы(ТД, НомерСтроки, "Экономия времени",
		З.Получить("МИН_ВРУЧНУЮ") + " − " + З.Получить("МИН_С_АВТО") + " = " + З.Получить("МИН_ЭКОНОМИЯ") + " мин ÷ 60 = " + З.Получить("ЧАСОВ") + " ч");
	ВывестиСтрокуФормулы(ТД, НомерСтроки, "Ставка в час",
		З.Получить("ОКЛАД") + " × " + З.Получить("КОЭФ_ВЗНОСОВ") + " ÷ " + З.Получить("ЧАСОВ_В_МЕСЯЦЕ_НОРМА") + " = " + З.Получить("СТАВКА") + " ₽");
	ВывестиСтрокуФормулы(ТД, НомерСтроки, "Экономия в рублях",
		З.Получить("ЧАСОВ_2") + " ч × " + З.Получить("СТАВКА_2") + " ₽ = " + З.Получить("РУБЛЕЙ") + " ₽ " + З.Получить("ЕД_ПЕРИОДА"));
	НомерСтроки = НомерСтроки + 1;

	ВывестиЗаголовокРаздела(ТД, НомерСтроки, "Параметры расчёта");
	Если П.РежимМесяцев Тогда
		ТекстРежима = "M месяцев из 12: M = " + ФЦел(П.ПорогМесяцев) + " (учтено " + ФЦел(Р.ПорогМесяцевФакт) + " из " + ФЦел(Р.ПолныхМесяцев) + " полных месяцев периода)";
	Иначе
		ТекстРежима = "порог N = " + ФЦел(П.ПорогДокументов) + " актов от поставщика за период";
	КонецЕсли;
	ВывестиСтрокуФормулы(ТД, НомерСтроки, "Кандидат", ТекстРежима);
	ВывестиСтрокуФормулы(ТД, НомерСтроки, "Нормы времени", "вручную " + ФМин(П.МинВручную) + " мин; сценарий " + ФМин(П.МинСценарий)
		+ " мин; проверка бухгалтером " + ФМин(П.МинПроверка) + " мин на документ");
	ВывестиСтрокуФормулы(ТД, НомерСтроки, "Оклад и ставка", ФЦел(П.Оклад) + " ₽ в месяц × " + ФМин(П.КоэфВзносов) + " ÷ " + ФМин(П.ЧасовВМесяце) + " ч");
	НомерСтроки = НомерСтроки + 1;

	ВывестиЗаголовокРаздела(ТД, НомерСтроки, "Расшифровка по поставщикам" + ?(П.Обезличить, " (обезличено)", ""));
	ВывестиШапкуТаблицы(ТД, НомерСтроки);
	НомерПоставщика = 0;
	Для Каждого СтрокаПоставщика Из Данные.Поставщики Цикл
		НомерПоставщика = НомерПоставщика + 1;
		Если П.Обезличить Тогда
			Имя = "Поставщик " + ФЦел(НомерПоставщика);
		Иначе
			Имя = СтрокаПоставщика.Наименование;
		КонецЕсли;
		ВывестиСтрокуТаблицы(ТД, НомерСтроки, ФЦел(НомерПоставщика), Имя, ФЦел(СтрокаПоставщика.Документов),
			ФЦел(СтрокаПоставщика.Месяцев), ?(ЭтоКандидат(СтрокаПоставщика, П, Р.ПорогМесяцевФакт), "да", "нет"));
	КонецЦикла;
	ВывестиСтрокуТаблицы(ТД, НомерСтроки, "", "Итого", З.Получить("ВСЕГО"), "", "кандидатов: " + З.Получить("КАНДИДАТЫ"));
	НомерСтроки = НомерСтроки + 1;

	ВывестиТекстНаВсюШирину(ТД, НомерСтроки, "Норма 5 мин на документ — НИИ ТСС Минтруда, рекомендации от 07.03.2014 № 003, п. 3.7.1 "
		+ "(работы и услуги поставщиков); носит рекомендательный характер (письмо Минтруда России от 27.08.2021 № 14-3/ООГ-8215). "
		+ "Время автоматической обработки " + ФМин(П.МинСценарий) + " мин и проверки бухгалтером " + ФМин(П.МинПроверка)
		+ " мин — практическая оценка сценария; значения можно изменить. Ставка часа = оклад × " + ФМин(П.КоэфВзносов)
		+ " ÷ " + ФМин(П.ЧасовВМесяце) + " ч.", 8, Ложь, ЦветСерый, 36);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьШиринуКолонки(ТД, НомерКолонки, Ширина)

	// Только оформление: если в каком-то релизе платформы обращение не сработает, отчёт всё равно сформируется.
	Попытка
		ТД.Область(1, НомерКолонки, 1, НомерКолонки).ШиринаКолонки = Ширина;
	Исключение
		Возврат; // ширина колонки останется стандартной
	КонецПопытки;
	Попытка
		ТД.Область("C" + Формат(НомерКолонки, "ЧГ=0")).ШиринаКолонки = Ширина;
	Исключение
		Возврат; // ширина колонки уже задана через область ячеек
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиЯчейку(ТД, НомерСтроки, НомерКолонки, Текст, Размер, Жирный, Цвет)

	Область = ТД.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Область.Текст = Текст;
	Область.Шрифт = Новый Шрифт("Arial", Размер, Жирный);
	Если Цвет <> Неопределено Тогда
		Область.ЦветТекста = Цвет;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиТекстНаВсюШирину(ТД, НомерСтроки, Текст, Размер, Жирный, Цвет, ВысотаСтроки = 0)

	Область = ТД.Область(НомерСтроки, 1, НомерСтроки, 5);
	Область.Объединить();
	Область.Текст = Текст;
	Область.Шрифт = Новый Шрифт("Arial", Размер, Жирный);
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Если Цвет <> Неопределено Тогда
		Область.ЦветТекста = Цвет;
	КонецЕсли;
	Если ВысотаСтроки > 0 Тогда
		Область.ВысотаСтроки = ВысотаСтроки;
	ИначеЕсли СтрДлина(Текст) > 110 Тогда
		Область.ВысотаСтроки = 12 * (Цел(СтрДлина(Текст) / 110) + 1);
	КонецЕсли;
	НомерСтроки = НомерСтроки + 1;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиЗаголовокРаздела(ТД, НомерСтроки, Текст)

	ВывестиЯчейку(ТД, НомерСтроки, 1, Текст, 11, Истина, Неопределено);
	НомерСтроки = НомерСтроки + 1;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиСтрокуПоказателя(ТД, НомерСтроки, Показатель, Значение, Пояснение, Цвет = Неопределено)

	ВывестиЯчейку(ТД, НомерСтроки, 2, Показатель, 10, Ложь, Неопределено);
	ВывестиЯчейку(ТД, НомерСтроки, 3, Значение, 12, Истина, Цвет);
	Область = ТД.Область(НомерСтроки, 4, НомерСтроки, 5);
	Область.Объединить();
	Область.Текст = Пояснение;
	Область.Шрифт = Новый Шрифт("Arial", 9, Ложь);
	Область.ЦветТекста = Новый Цвет(128, 134, 154);
	НомерСтроки = НомерСтроки + 1;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиСтрокуФормулы(ТД, НомерСтроки, Показатель, Формула)

	ВывестиЯчейку(ТД, НомерСтроки, 2, Показатель, 10, Ложь, Неопределено);
	Область = ТД.Область(НомерСтроки, 3, НомерСтроки, 5);
	Область.Объединить();
	Область.Текст = Формула;
	Область.Шрифт = Новый Шрифт("Arial", 10, Ложь);
	НомерСтроки = НомерСтроки + 1;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиШапкуТаблицы(ТД, НомерСтроки)

	ВывестиСтрокуТаблицы(ТД, НомерСтроки, "№", "Поставщик", "Документов", "Месяцев с актом", "Кандидат", Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВывестиСтрокуТаблицы(ТД, НомерСтроки, Номер, Поставщик, Документов, Месяцев, Кандидат, Шапка = Ложь)

	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Тексты = Новый Массив;
	Тексты.Добавить(Номер);
	Тексты.Добавить(Поставщик);
	Тексты.Добавить(Документов);
	Тексты.Добавить(Месяцев);
	Тексты.Добавить(Кандидат);
	Для НомерКолонки = 1 По 5 Цикл
		Область = ТД.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
		Область.Текст = Тексты[НомерКолонки - 1];
		Область.Шрифт = Новый Шрифт("Arial", 9, Шапка);
		Область.Обвести(Линия, Линия, Линия, Линия);
		Если НомерКолонки <> 2 Тогда
			Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		КонецЕсли;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;

КонецПроцедуры

#КонецОбласти

#Область Форматирование

// Форматтеры повторяют функции дашборда v10: int(), one(), two(), mins(). Зеркало: tests/mirror.py.
&НаСервереБезКонтекста
Функция ФЦел(Число)

	Возврат Формат(Окр(Число, 0), "ЧДЦ=0; ЧН=0");

КонецФункции

&НаСервереБезКонтекста
Функция ФОдин(Число)

	Округленное = Окр(Число, 1);
	Если Округленное = 0 Тогда
		Возврат "0,0";
	КонецЕсли;
	Возврат Формат(Округленное, "ЧДЦ=1");

КонецФункции

&НаСервереБезКонтекста
Функция ФДва(Число)

	Округленное = Окр(Число, 2);
	Если Округленное = 0 Тогда
		Возврат "0,00";
	КонецЕсли;
	Возврат Формат(Округленное, "ЧДЦ=2");

КонецФункции

&НаСервереБезКонтекста
Функция ФМин(Число)

	Возврат Формат(Окр(Число, 2), "ЧН=0");

КонецФункции

// Число для CSS/SVG: точка как разделитель, без группировки разрядов.
&НаСервереБезКонтекста
Функция ЧислоДляСтиля(Число)

	Возврат Формат(Окр(Число, 2), "ЧРД=.; ЧГ=0; ЧН=0");

КонецФункции

&НаСервереБезКонтекста
Функция ФормаСлова(Число, Форма1, Форма2, Форма5)

	Остаток = Цел(Макс(Число, -Число)) % 100;
	Если Остаток >= 11 И Остаток <= 19 Тогда
		Возврат Форма5;
	КонецЕсли;
	Остаток = Остаток % 10;
	Если Остаток = 1 Тогда
		Возврат Форма1;
	ИначеЕсли Остаток >= 2 И Остаток <= 4 Тогда
		Возврат Форма2;
	КонецЕсли;
	Возврат Форма5;

КонецФункции

// «от N поставщика / поставщиков» (родительный падеж после «от»).
&НаСервереБезКонтекста
Функция ПоставщикаИлиПоставщиков(Число)

	Остаток = Цел(Макс(Число, -Число)) % 100;
	Если Остаток % 10 = 1 И Остаток <> 11 Тогда
		Возврат "поставщика";
	КонецЕсли;
	Возврат "поставщиков";

КонецФункции

// «N и более акта / актов».
&НаСервереБезКонтекста
Функция АктаИлиАктов(Число)

	Возврат ФормаСлова(Число, "акта", "акта", "актов");

КонецФункции

